<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://android.com"
    package="com.example.floatingbutton"> <!-- Thay bằng package name của bạn nếu có -->

    <!-- Quyền hiển thị trên ứng dụng khác -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Nut Noi App"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">
        
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Khai báo Service chạy ngầm cho nút nổi -->
        <service
            android:name=".FloatingService"
            android:enabled="true"
            android:exported="false" />
    </application>

</manifest>
